{
  "name": "uslugg",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Vercel cleanUrls + trailingSlash:false
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
